generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  NEW
  CONFIRMED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum FurnitureType {
  SOFA_2
  SOFA_3
  CORNER_SOFA
  CORNER_SOFA_5
  U_SHAPE_SOFA
}

model Order {
  id              String        @id @default(cuid())
  name            String
  phone           String
  email           String?
  address         String?
  furnitureType   FurnitureType
  seats           Int?
  services        String[]      @default([])
  comment         String?
  calculatedPrice Int?
  source          String?
  utm             Json?
  status          OrderStatus   @default(NEW)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
}
